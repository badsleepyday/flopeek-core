{
  "schemaVersion": "flopeek-package-policy/v2",
  "package": {
    "name": "flopeek",
    "publication": {
      "state": "prepared",
      "distTag": "beta",
      "approvalFile": "packaging/npm-publication-approval.json"
    },
    "bin": "src/cli.js",
    "minimumNodeMajor": 22
  },
  "allowedExactPaths": [
    "ARCHITECTURE.md",
    "LICENSE",
    "BENCHMARKS.md",
    "PRODUCT.md",
    "README.md",
    "ROADMAP.md",
    "SUPPORT.md",
    "package.json",
    "benchmarks/agent-comparison-report.json",
    "benchmarks/agent-comparison-runs.template.json",
    "benchmarks/framework-entry-production-evidence.json",
    "benchmarks/handoff-quality.json",
    "benchmarks/orientation-baseline.json",
    "benchmarks/orientation-cases.json",
    "benchmarks/orientation-flopeek.json",
    "benchmarks/private-dogfood-summary.json",
    "benchmarks/production-static-evidence.json",
    "benchmarks/public-proof.json",
    "benchmarks/real-repository-corpus.json",
    "benchmarks/renderer-projection-corpus.json",
    "benchmarks/semantic-flow-suggestions.json",
    "benchmarks/semantic-suggestion-feedback-contract.json",
    "benchmarks/monorepo-package-selection.json",
    "contracts/adapter-capabilities.json",
    "contracts/go-stdlib-catalog.json",
    "contracts/product-contract.json",
    "packaging/native-rollout-evidence.json"
  ],
  "allowedDirectories": [
    "docs",
    "examples/commerce-showcase",
    "integrations/skills/flopeek",
    "public",
    "src"
  ],
  "requiredPaths": [
    "LICENSE",
    "README.md",
    "docs/README.md",
    "docs/using-flopeek.md",
    "docs/assets/shared-context-workflow.svg",
    "docs/assets/screenshots/flow-lens.png",
    "package.json",
    "contracts/go-stdlib-catalog.json",
    "contracts/product-contract.json",
    "packaging/native-rollout-evidence.json",
    "src/cli.js",
    "src/core-compatibility.js",
    "src/mcp.js",
    "src/scanner.js",
    "public/index.html",
    "public/app.js",
    "public/styles.css",
    "integrations/skills/flopeek/SKILL.md",
    "examples/commerce-showcase/flopeek-showcase.json",
    "benchmarks/public-proof.json",
    "benchmarks/real-repository-corpus.json",
    "benchmarks/orientation-cases.json"
  ],
  "deniedPathSegments": [
    ".agent-team",
    ".agents",
    ".flopeek",
    ".git",
    ".github",
    "node_modules"
  ],
  "deniedBasenames": [
    ".env",
    ".npmrc",
    "credentials.json",
    "id_rsa",
    "id_ed25519"
  ],
  "deniedBasenamePrefixes": [
    ".env.",
    "credentials.",
    "secrets."
  ],
  "deniedSuffixes": [
    ".crt",
    ".key",
    ".log",
    ".map",
    ".pem",
    ".pfx"
  ],
  "maximumEntries": 205,
  "maximumUnpackedBytes": 3000000
}
